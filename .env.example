# Ka-myii — Environment Configuration
# Copy to .env and customise. Every value has a sensible default.

# --- Flask / server ---
FLASK_ENV=development
SECRET_KEY=change-this-in-production
HOST=0.0.0.0
PORT=5000

# --- Image generation ---
# Default checkpoint. A Hugging Face id is auto-downloaded; or drop a
# .safetensors checkpoint into models/checkpoints and select it in the UI.
KAMYII_MODEL_NAME=cagliostrolab/animagine-xl-3.1
# Pipeline: auto | sd15 | sdxl
KAMYII_MODEL_PIPELINE=auto
# Use a local CivitAI checkpoint instead (absolute path to .safetensors):
# KAMYII_CUSTOM_MODEL_PATH=/path/to/illustriousXL.safetensors
# Optional custom VAE (folder or .safetensors):
# KAMYII_CUSTOM_VAE_PATH=/path/to/vae.safetensors

# Generation defaults
KAMYII_DEFAULT_WIDTH=832
KAMYII_DEFAULT_HEIGHT=1216
KAMYII_DEFAULT_STEPS=28
KAMYII_DEFAULT_CFG=6.5
KAMYII_DEFAULT_SAMPLER=DPM++ 2M Karras
KAMYII_CLIP_SKIP=2

# Performance
# KAMYII_CPU_OFFLOAD=true     # lower VRAM (8GB cards), a bit slower
# KAMYII_USE_REFINER=false

# --- Decomposition ---
KAMYII_AI_SEGMENTATION=true
KAMYII_INPAINT_OCCLUDED=true
# Optional Segment Anything 2 checkpoint for best automatic decomposition:
# KAMYII_SAM2_CHECKPOINT=/path/to/sam2_hiera_large.pt
# KAMYII_SAM2_CONFIG=sam2_hiera_l.yaml

# --- Live2D packaging ---
KAMYII_TEXTURE_SIZE=4096

# --- GPU ---
# CUDA_VISIBLE_DEVICES=0
